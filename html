<style>
:root{--bg:#0a0a0b;--panel:#141416;--line:#2a2a2e;--chalk:#f4f1e8;--dim:#9a978d;--gold:#e8b13a;--red:#e5262b;--cyan:#36b8ff;--hl:#f7e84a;--accent:var(--gold);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
