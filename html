<script>
const $=s=>document.querySelector(s),mem={};
const S={get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d}catch(e){return k in mem?mem[k]:d}},set(k,v){mem[k]=v;try{localStorage.setItem(k,JSON.stringify(v))}catch(e){}}};
const T=(y,m,d,h=9)=>new Date(y,m-1,d,h).getTime();
const EX=[["JEE Main Session 1",T(2027,1,20),"20–24 & 28 Jan 2027","jeemain.nta.nic.in"],["JEE Main registration closes",T(2026,11,22,23),"22 Nov 2026, 11:50 PM","late fee till 26 Nov"],["Organic daily set ends",T(2026,12,6,23),"6 Dec 2026","your own deadline"],["JEE Main Session 2",T(2027,4,2),"2–7 Apr 2027","jeemain.nta.nic.in"],["BITSAT Session 1 (expected)",T(2027,4,15),"mid–late Apr 2027","bitsadmission.com"],["VITEEE (expected)",T(2027,4,28),"28 Apr – 2 May 2027","viteee.vit.ac.in"],["JEE Advanced (expected)",T(2027,5,17),"May 2027","jeeadv.ac.in"]];
function left(t){let s=Math.max(0,Math.floor((t-Date.now())/1e3));return[Math.floor(s/86400),Math.floor(s%86400/3600),Math.floor(s%3600/60),s%60]}
function tick(){const[a,b,c,d]=left(EX[0][1]);$('#cd').innerHTML=[[a,'days'],[b,'hours'],[c,'min'],[d,'sec']].map(x=>`<div><b>${String(x[0]).padStart(2,'0')}</b><span>${x[1]}</span></div>`).join('');
$('#exgrid').innerHTML=EX.map(e=>{const[d,h]=left(e[1]);return`<div class="card"><h3>${e[0]}</h3><div class="t">${d} days ${h} h</div><small>${e[2]}<br>${e[3]}</small></div>`}).join('');
$('#left').textContent=Math.max(0,Math.ceil((EX[2][1]-Date.now())/864e5))}
tick();setInterval(tick,1000);
 
/* modes */
const M={study:["Study",50*60,"50 min deep work, then a 10 min break."],mock:["Mock test",180*60,"3 hours, no phone. Same format as JEE Main: 75 questions, +4 / −1."],revise:["Revise",25*60,"25 min sprint over formula sheets and the error log."]};
let mode='study',rem=M.study[1],run=null;
function mm(){$('#timer').textContent=String(Math.floor(rem/3600)?Math.floor(rem/3600)+':':'')+String(Math.floor(rem%3600/60)).padStart(2,'0')+':'+String(rem%60).padStart(2,'0')}
function setMode(m){mode=m;document.body.dataset.mode=m;rem=M[m][1];clearInterval(run);run=null;$('#go').textContent='Start';$('#modenote').textContent=M[m][2];$('#modebtns').innerHTML=Object.keys(M).map(k=>`<button class="${k==m?'on':''}" data-m="${k}">${M[k][0]}</button>`).join('');mm()}
$('#modebtns').onclick=e=>e.target.dataset.m&&setMode(e.target.dataset.m);
const dk=()=>new Date().toDateString();
function showToday(){const l=S.get('log',{});$('#today').textContent=Math.round((l[dk()]||0)/60)}
$('#go').onclick=()=>{if(run){clearInterval(run);run=null;$('#go').textContent='Resume';return}$('#go').textContent='Pause';run=setInterval(()=>{rem--;const l=S.get('log',{});l[dk()]=(l[dk()]||0)+1;S.set('log',l);showToday();mm();if(rem<=0){clearInterval(run);run=null;$('#go').textContent='Start';rem=M[mode][1];mm()}},1000)};
$('#rs').onclick=()=>setMode(mode);setMode('study');showToday();
 
/* organic */
const D0=new Date(2026,10,4),ND=33,fmt=d=>d.toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'});
const oidx=()=>Math.min(ND-1,Math.max(0,Math.floor((new Date().setHours(0,0,0,0)-D0)/864e5)));
const ocnt=d=>d?d.s.filter(Boolean).length:0,oblank=()=>({s:Array(12).fill(0),t:''});
let di=oidx();
function org(){const o=S.get('org2',{}),day=o[di]||oblank(),d=new Date(D0.getTime()+di*864e5);
$('#dlab').textContent=`Day ${di+1} of ${ND} · ${fmt(d)}`;
$('#qs').innerHTML=`<div class="slots">${day.s.map((v,i)=>`<button class="sl s${v}" data-i="${i}" aria-label="Question ${i+1}, ${['not done','solved','revisit'][v]}">${i+1}</button>`).join('')}</div>`;
$('#otopic').value=day.t;
const n=Object.values(o).reduce((a,x)=>a+ocnt(x),0),c=ocnt(day),r=day.s.filter(v=>v==2).length;
$('#obar').style.width=n/(ND*12)*100+'%';
$('#otxt').textContent=`This day: ${c}/12 done${r?` · ${r} to revisit`:''} · overall ${n} of ${ND*12}`;
const t0=oidx();let st=0,k=ocnt(o[t0])>=12?t0:t0-1;while(k>=0&&ocnt(o[k])>=12){st++;k--}
$('#streak').textContent=st+' day streak'+(st?'. Keep going.':'. Finish 12 today to start one.');
$('#heat').innerHTML=Array.from({length:ND},(_,j)=>{const x=ocnt(o[j]);return`<button class="hm${j==di?' cur':''}" data-j="${j}" style="--a:${x/12}" title="${fmt(new Date(D0.getTime()+j*864e5))}: ${x}/12">${j+1}</button>`}).join('')}
$('#qs').onclick=e=>{const b=e.target.closest('.sl');if(!b)return;const o=S.get('org2',{}),day=o[di]||oblank();day.s[b.dataset.i]=(day.s[b.dataset.i]+1)%3;o[di]=day;S.set('org2',o);org()};
$('#otopic').oninput=e=>{const o=S.get('org2',{}),day=o[di]||oblank();day.t=e.target.value;o[di]=day;S.set('org2',o)};
$('#heat').onclick=e=>{const b=e.target.closest('.hm');if(b){di=+b.dataset.j;org()}};
$('#prev').onclick=()=>{di=Math.max(0,di-1);org()};$('#next').onclick=()=>{di=Math.min(ND-1,di+1);org()};$('#tod').onclick=()=>{di=oidx();org()};org();
 
/* schedule */
